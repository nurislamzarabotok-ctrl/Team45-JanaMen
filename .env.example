# Optional: default setup only needs GEMINI_KEY.txt, no .env required.
JANA_AI_PROVIDER=gemini
JANA_GEMINI_MODEL=auto
JANA_AI_CHAT_MODE=chat
JANA_AI_TIMEOUT=45
JANA_AI_DAILY_LIMIT=0
# Explicit model may be set instead of auto; keys stay in GEMINI_KEY.txt.

# Public deployment only: set your actual HTTPS origin, then restart server.
# JANA_PUBLIC_URL=https://hr.example.com
